# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Editor
.vscode/
.idea/

# Claude workspace settings live above the repo, but ignore them if they ever land here
.claude/settings.local.json

# Notebooks that demonstrate file handling create files as they run. They clean up
# after themselves, but a cell that fails partway would leave them behind, and CI
# executes notebooks with the notebook's own directory as the working directory.
notebooks/**/scratch/
